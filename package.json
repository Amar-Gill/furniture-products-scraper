{
    "name": "furniture-products-scraper",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "Discover Structube product URLs from sitemaps without browser navigation.",
    "dependencies": {
        "@crawlee/impit-client": "^3.0.0",
        "crawlee": "^3.0.0",
        "playwright": "1.64.0"
    },
    "devDependencies": {
        "@apify/tsconfig": "^0.2.0",
        "tsx": "^4.4.0",
        "typescript": "~6.0.0",
        "@types/node": "^24.0.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "discover:categories": "tsx src/categories.ts",
        "scrape:details": "tsx src/details.ts",
        "build": "tsc",
        "test": "node --import tsx --test tests/*.test.ts",
        "postinstall": "npx crawlee install-playwright-browsers"
    },
    "author": "It's not you it's me",
    "license": "ISC"
}
