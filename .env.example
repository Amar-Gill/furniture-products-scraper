# Settings for `npm run scrape:details` and the chat app in chat/. Copy to .env and uncomment
# what you need; variables set in the shell take precedence over this file.
# PRODUCTS_FILE=products.json
# OUTPUT_FILE=product-details.json
# LIMIT=20
# MAX_CONCURRENCY=2
# MAX_REQUESTS_PER_MINUTE=20

# Chat app: answers questions about OUTPUT_FILE.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-6-luna
